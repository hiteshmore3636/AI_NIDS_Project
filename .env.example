# Application Configuration
APP_NAME=AI-NIDS
APP_ENV=development
DEBUG=True
SECRET_KEY=supersecret-nids-jwt-token-replace-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./nids.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/nids_db

# Network Sniffing & Capture
CAPTURE_INTERFACE=eth0
# Windows alternative example: '\Device\NPF_{...}' or 'Ethernet'
DEFAULT_PCAP_PATH=./data/sample.pcap
FLOW_ACTIVE_TIMEOUT=120
FLOW_IDLE_TIMEOUT=5

# Thresholds & Detection
SUPERVISED_THRESHOLD=0.80
ANOMALY_THRESHOLD=0.75
TARGET_FPR=0.01

# Alert Notifications (Optional / Production)
ALERT_EMAIL_ENABLED=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASS=app-specific-password
ALERT_RECIPIENT_EMAIL=admin@example.com

TELEGRAM_ALERT_ENABLED=False
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin Seed Account
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=AdminSecurePassword123!
